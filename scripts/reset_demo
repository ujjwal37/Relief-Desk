#!/usr/bin/env python3
"""Reload the synthetic Kerala demo into a running Relief Desk API.

The queue lives in the API process. This asks that process to drop in-memory
cases and load the seed pack again. Restarting the API does the same thing,
because seeds load on startup.

    python scripts/reset_demo

Optional: RELIEF_DESK_API=http://127.0.0.1:8000
"""
from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.request

API = os.environ.get("RELIEF_DESK_API", "http://127.0.0.1:8000").rstrip("/")


def main() -> int:
    request = urllib.request.Request(
        f"{API}/api/demo/reset",
        data=b"{}",
        headers={
            "Authorization": "Bearer demo-coordinator-token",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            body = json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as err:
        print(err.read().decode("utf-8", errors="replace"))
        return 1
    except urllib.error.URLError as err:
        print(f"Could not reach {API} ({err.reason}).")
        print("Start the API, then run this script again:")
        print("  cd services/api && python -m uvicorn app.main:app --host 127.0.0.1 --port 8000")
        print("A fresh API process also reloads the synthetic seeds.")
        return 1
    print(json.dumps(body, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
