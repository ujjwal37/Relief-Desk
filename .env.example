# Copy to services/api/.env (or .env at the repo root). Placeholders only. Never commit .env.
# List values are JSON arrays so pydantic-settings can read them.
# Cloud Run: secrets are mounted, and the other vars live in deploy/cloudrun.env.yaml.

# --- Gemini / ADK ---
GEMINI_API_KEY=replace-me
# https://ai.google.dev/gemini-api/docs/models (2026-10-09): gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash
# https://ai.google.dev/gemini-api/docs/embeddings
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
GEMINI_EMBED_TASK=SEMANTIC_SIMILARITY
# Kill-switch. false uses the deterministic fallback and does not call Gemini.
GEMINI_ENABLED=true
GEMINI_DAILY_CALL_CAP=2000
GEMINI_TIMEOUT_S=20
# Model calls at once. Others queue, critical first. 1 for a local model that serves one call at a time.
AI_CONCURRENCY=2
# auto calls Gemini when GEMINI_API_KEY is a real key. replay serves data/ai_cache.
# fallback never calls the network. DEMO_MODE does not block a real key.
AI_MODE=auto
DEMO_MODE=true
# small: two cases and a few teams (the current demo). full: the flood pack.
DEMO_SEED=small
# --- Test LLM provider (local testing only, never benchmark or submission numbers) ---
# LLM_PROVIDER=openai_compat sends intake and Ask the desk to an OpenAI-compatible API
# (NVIDIA NIM by default). The trace shows "Test model (NVIDIA)", never Gemini.
# Get a key at build.nvidia.com and put it only in services/api/.env. Never commit a real key.
LLM_PROVIDER=
OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_COMPAT_API_KEY=replace-me
OPENAI_COMPAT_MODEL=meta/llama-3.3-70b-instruct
# Empty: duplicates use local similarity and rules. Example: nvidia/llama-3.2-nv-embedqa-1b-v2
OPENAI_COMPAT_EMBED_MODEL=
OPENAI_COMPAT_EMBED_INPUT_TYPE=query
OPENAI_COMPAT_TIMEOUT_S=30
# Name inside "Test model (...)". Empty derives it from the base URL host.
OPENAI_COMPAT_LABEL=
# --- Google Cloud ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1
# Local Firestore emulator only. Leave empty on Cloud Run.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
PUBSUB_TOPIC_ALERTS=alerts
GCS_BUCKET_MEDIA=your-project-relief-desk-media
# --- Maps (browser key, referrer-restricted to the app origin) ---
# Set this only in the API environment. The web app asks GET /api/config/maps
# and loads Google Maps JavaScript only when the value is a real key.
# Empty or replace-me keeps the built-in SVG map. Never commit a real key.
GOOGLE_MAPS_API_KEY=replace-me
# --- App ---
LOG_LEVEL=INFO
API_CORS_ORIGINS=["http://localhost:4200","http://localhost:8000"]
SALT_PHONE_HASH=replace-me
# Signs coordinator JWTs. The process default is a demo constant.
# On Cloud Run, mount a Secret Manager value. Do not commit a real secret.
JWT_SECRET=replace-me
# Local Auth emulator only. Leave empty on Cloud Run.
FIREBASE_AUTH_EMULATOR_HOST=
RATE_LIMIT_REPORTS_PER_HOUR=10
DEFAULT_LANG=en
SUPPORTED_LANGS=["en","hi","hinglish","ml"]
